# Configurações para desenvolvimento e testes locais.
# Copie para .env e ajuste os valores. O .env NUNCA deve ser commitado.

# ViaCEP API
VIACEP_BASEURL_API=https://viacep.com.br/ws/
VIACEP_TIMEOUT_SECONDS=10

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=mycep
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=troque-esta-senha
# Prefer em desenvolvimento; Require contra o RDS
POSTGRES_SSLMODE=Prefer

# Aplica migrations pendentes no boot (só com instância única)
DATABASE_MIGRATE_ON_STARTUP=true

# Ambiente
ASPNETCORE_ENVIRONMENT=Development
